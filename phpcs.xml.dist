<?xml version="1.0"?>
<ruleset name="rampart/quality-checker">
    <description>Coding standard for the quality-checker package itself.</description>

    <rule ref="PSR12"/>

    <!-- The package intentionally keeps some long lines (messages, tables);
         line length is a style preference, not a correctness issue. -->
    <rule ref="Generic.Files.LineLength">
        <severity>0</severity>
    </rule>

    <!-- tools/build-phar.php is a CLI entry script: small local helpers plus
         the executable build steps are intentional, not a library design flaw. -->
    <rule ref="PSR1.Files.SideEffects.FoundWithSymbols">
        <exclude-pattern>*/tools/build-phar.php</exclude-pattern>
    </rule>

    <arg name="extensions" value="php"/>
    <exclude-pattern>*/vendor/*</exclude-pattern>
</ruleset>
